# Local developer profile. Copy to .env.development; the target is ignored by Git.
# The API binds to loopback only, so it is not exposed to the local network.
DOCUMENT_PROCESSING_BIND_ADDRESS=127.0.0.1
DOCUMENT_PROCESSING_PORT=5080

# Use distinct values and copy DOCUMENT_PROCESSING_API_KEY to the Orchestrator's
# appsettings.Development.local.json. These values are only development examples.
DOCUMENT_PROCESSING_API_KEY=replace-with-a-local-development-api-key
DOCLING_API_KEY=replace-with-a-different-local-docling-key

# Keep the local stack small enough for a developer workstation. Raise these only
# when measuring a real local workload.
DOCLING_MAX_FILE_SIZE_BYTES=26214400
DOCLING_MAX_PAGE_COUNT=100
DOCUMENT_PROCESSING_MAX_QUEUED_JOBS=5
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=300
DOCLING_POLL_INTERVAL_MS=1000
DOCUMENT_PROCESSING_CPU_MAX_CONCURRENT_JOBS=1
DOCLING_CPU_WORKERS=1
DOCLING_CPU_THREADS=2
DOCLING_CPU_LIMIT=4.0
DOCLING_MEMORY_LIMIT=6g
DOCLING_SHM_SIZE=1g
DOCUMENT_PROCESSING_CPU_LIMIT=1.0
DOCUMENT_PROCESSING_MEMORY_LIMIT=1g
