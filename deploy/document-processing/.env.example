# Required. Generate distinct random values for both keys.
DOCUMENT_PROCESSING_API_KEY=replace-with-a-long-random-api-key
DOCLING_API_KEY=replace-with-a-different-long-random-api-key

# Host port exposed only for the RAG Orchestrator or reverse proxy.
DOCUMENT_PROCESSING_PORT=5080

# Shared safety limits. They must match the Orchestrator configuration.
DOCLING_MAX_FILE_SIZE_BYTES=26214400
DOCLING_MAX_PAGE_COUNT=100
DOCUMENT_PROCESSING_MAX_CONCURRENT_JOBS=2
DOCUMENT_PROCESSING_MAX_QUEUED_JOBS=20
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=300
DOCLING_POLL_INTERVAL_MS=1000

# CPU profile only; set according to the host capacity.
DOCLING_WORKERS=2
DOCLING_CPU_THREADS=4
