# Required. Generate distinct random values for both keys.
DOCUMENT_PROCESSING_API_KEY=replace-with-a-long-random-api-key
DOCLING_API_KEY=replace-with-a-different-long-random-api-key

# Host port exposed only for the RAG Orchestrator or reverse proxy.
DOCUMENT_PROCESSING_PORT=5080

# Shared safety limits. They must match the Orchestrator configuration.
DOCLING_MAX_FILE_SIZE_BYTES=26214400
DOCLING_MAX_PAGE_COUNT=100
DOCUMENT_PROCESSING_MAX_QUEUED_JOBS=20
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=300
DOCLING_POLL_INTERVAL_MS=1000

# OCR profile. Tesseract uses its three-letter language codes; the image contains:
# ces, dan, deu, eng, fin, fra, hun, ita, nld, nor, pol, por, ron, rus,
# slk, spa, swe, tur and ukr. Keep only languages expected in one document.
DOCLING_OCR_PRESET=tesseract
DOCLING_OCR_LANGUAGES=pol,eng
DOCLING_MINIMUM_TEXT_QUALITY=0.6
DOCLING_ENABLE_TABLE_FALLBACK=true
DOCLING_TABLE_FALLBACK_OCR_PRESET=auto
DOCLING_TABLE_FALLBACK_OCR_LANGUAGES=
DOCLING_MINIMUM_TABLE_COMPLETENESS=0.85

# CPU profile for llm-cuda-srv: Intel i5-14600K (20 logical CPUs), 46 GiB RAM.
# Two conversion workers use at most eight logical CPUs and leave capacity for the
# existing embedding, reranker, and Ollama services.
DOCUMENT_PROCESSING_CPU_MAX_CONCURRENT_JOBS=2
DOCLING_CPU_WORKERS=2
DOCLING_CPU_THREADS=4
DOCLING_CPU_LIMIT=8.0
DOCLING_MEMORY_LIMIT=10g
DOCLING_SHM_SIZE=2g
DOCUMENT_PROCESSING_CPU_LIMIT=1.0
DOCUMENT_PROCESSING_MEMORY_LIMIT=1g

# GPU profile for llm-cuda-srv: NVIDIA GeForce RTX 5060 Ti (16 GiB VRAM).
# It is an alternative to the CPU profile, not a concurrent workload with a large
# Ollama model. The GPU start script checks this amount of free VRAM first.
DOCUMENT_PROCESSING_GPU_MAX_CONCURRENT_JOBS=1
DOCLING_GPU_WORKERS=1
DOCLING_GPU_CPU_THREADS=4
DOCLING_GPU_CPU_LIMIT=4.0
DOCLING_GPU_MEMORY_LIMIT=8g
DOCUMENT_PROCESSING_GPU_CPU_LIMIT=1.0
DOCUMENT_PROCESSING_GPU_MEMORY_LIMIT=1g
DOCLING_GPU_MIN_FREE_MIB=6144
