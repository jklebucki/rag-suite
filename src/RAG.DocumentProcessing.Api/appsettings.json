{
  "DocumentProcessing": {
    "ApiKey": "",
    "MaxFileSizeBytes": 26214400,
    "MaxPageCount": 100,
    "MaxConcurrentJobs": 2,
    "MaxQueuedJobs": 20,
    "JobTimeoutSeconds": 300,
    "MinimumCharactersPerPage": 40,
    "WorkDirectory": "App_Data/document-processing"
  },
  "Docling": {
    "Endpoint": "http://localhost:5001",
    "ApiKey": "",
    "PollIntervalMilliseconds": 1000,
    "MinimumCharactersPerPage": 40,
    "OcrPreset": "tesseract",
    "OcrLanguages": "pol,eng",
    "MinimumTextQuality": 0.6,
    "EnableTableFallback": true,
    "TableFallbackOcrPreset": "auto",
    "TableFallbackOcrLanguages": "",
    "MinimumTableCompleteness": 0.85
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
